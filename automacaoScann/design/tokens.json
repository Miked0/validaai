      "card": { "value": "#23272A", "type": "color", "description": "Card/panel background" },
      "input": { "value": "#1E1F22", "type": "color", "description": "Input field background" },
      "hover": { "value": "#2C2F33", "type": "color", "description": "Hover state background" }
    },
    "fg": {
      "primary": { "value": "#FFFFFF", "type": "color", "description": "Primary text" },
      "muted": { "value": "#CCCCCC", "type": "color", "description": "Secondary/muted text" },
      "disabled": { "value": "#888888", "type": "color", "description": "Disabled text" }
    },
    "accent": {
      "primary": { "value": "#5865F2", "type": "color", "description": "Primary accent (Discord blurple)" },
